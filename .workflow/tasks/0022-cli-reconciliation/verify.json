{
  "profiles": {
    "default": {
      "commands": [
        {
          "id": "api-unit",
          "command": "yarn workspace @actual-app/api exec vitest run -t \"reconciliation\""
        },
        { "id": "cli-unit", "command": "yarn workspace @actual-app/cli test" },
        { "id": "root-types", "command": "yarn typecheck" },
        {
          "id": "cli-build",
          "command": "yarn exec lage build --scope=@actual-app/cli --no-cache"
        },
        {
          "id": "server-build",
          "command": "yarn workspace @actual-app/sync-server build"
        },
        {
          "id": "reconciliation-integration",
          "command": "yarn workspace @actual-app/cli exec node --test integration/reconciliation.test.mjs"
        },
        {
          "id": "lint",
          "command": "yarn exec oxlint packages/loot-core/src/server/accounts/reconcile.ts packages/cli/src/commands/reconcile.ts"
        },
        {
          "id": "format",
          "command": "yarn exec oxfmt --check packages/loot-core/src/server/accounts/reconcile.ts packages/cli/src/commands/reconcile.ts packages/cli/integration/reconciliation.test.mjs"
        }
      ]
    }
  }
}
