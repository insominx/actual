{
  "profiles": {
    "default": {
      "commands": [
        {
          "id": "api-unit",
          "command": "yarn workspace @actual-app/api test"
        },
        {
          "id": "cli-unit",
          "command": "yarn workspace @actual-app/cli test"
        },
        {
          "id": "root-types",
          "command": "yarn typecheck"
        },
        {
          "id": "cli-build",
          "command": "yarn exec lage build --scope=@actual-app/cli --no-cache"
        },
        {
          "id": "server-build",
          "command": "yarn workspace @actual-app/sync-server build"
        },
        {
          "id": "transfers-integration",
          "command": "yarn workspace @actual-app/cli exec node --test integration/transfers.test.mjs"
        },
        {
          "id": "lint",
          "command": "yarn exec oxlint packages/loot-core/src/server/transfers/inspect.ts packages/loot-core/src/server/transfers/guarded.ts packages/cli/src/commands/transfers.ts packages/cli/integration/transfers.test.mjs"
        },
        {
          "id": "format",
          "command": "yarn exec oxfmt --check packages/loot-core/src/server/transfers/inspect.ts packages/loot-core/src/server/transfers/guarded.ts packages/cli/src/commands/transfers.ts packages/cli/integration/transfers.test.mjs packages/docs/docs/api/cli.md"
        }
      ]
    }
  }
}
