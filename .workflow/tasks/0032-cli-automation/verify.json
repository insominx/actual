{
  "profiles": {
    "default": {
      "commands": [
        {
          "id": "cli-unit",
          "command": "yarn workspace @actual-app/cli test"
        },
        {
          "id": "root-types",
          "command": "yarn typecheck"
        },
        {
          "id": "cli-build",
          "command": "yarn exec lage build --scope=@actual-app/cli --no-cache"
        },
        {
          "id": "server-build",
          "command": "yarn workspace @actual-app/sync-server build"
        },
        {
          "id": "automation-integration",
          "command": "yarn workspace @actual-app/cli exec node --test integration/jobs.test.mjs"
        },
        {
          "id": "lint",
          "command": "yarn exec oxlint packages/cli/src/jobs.ts packages/cli/src/commands/jobs.ts packages/cli/src/jobs.test.ts"
        },
        {
          "id": "format",
          "command": "yarn exec oxfmt --check packages/cli/src/jobs.ts packages/cli/src/commands/jobs.ts packages/cli/src/jobs.test.ts packages/cli/integration/jobs.test.mjs"
        }
      ]
    }
  }
}
